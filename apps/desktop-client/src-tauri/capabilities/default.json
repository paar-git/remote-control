{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability set for the main window. Permissions are added only as features that need them land; nothing here grants filesystem, shell or HTTP access to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "os:allow-platform",
    "os:allow-version",
    "dialog:allow-confirm",
    "dialog:allow-message"
  ]
}
