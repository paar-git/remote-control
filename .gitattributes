# The whole tree is LF in the repository. rustfmt and prettier are both configured
# for LF, so letting Git rewrite line endings on checkout would leave every file
# permanently "modified" against the formatters on Windows.
* text=auto eol=lf

# Shell scripts must keep LF or they will not run under bash.
*.sh text eol=lf
*.ps1 text eol=lf

# Binary assets: never touch these.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfiles are generated; collapse them in diffs and never merge them by hand.
Cargo.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true -diff
